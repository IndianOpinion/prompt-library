{
    "name": "indianopinion/prompt-library",
    "description": "Versioned prompt templates for WordPress with typed variables, a strict renderer and a capped test runner.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "keywords": ["wordpress", "prompt", "template", "llm", "versioning"],
    "homepage": "https://github.com/IndianOpinion/prompt-library",
    "support": {
        "issues": "https://github.com/IndianOpinion/prompt-library/issues",
        "email": "hello@indianopinion.org"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/IndianOpinion/llm-json-php"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-mbstring": "*",
        "indianopinion/llm-json-php": "^0.1"
    },
    "require-dev": {
        "php-stubs/wordpress-stubs": "^6.4",
        "php-stubs/wp-cli-stubs": "^2.10",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "IndianOpinion\\PromptLibrary\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IndianOpinion\\PromptLibrary\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress --memory-limit=1G",
        "cs": "phpcs",
        "check": ["@cs", "@stan", "@test"]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    },
    "minimum-stability": "stable"
}
