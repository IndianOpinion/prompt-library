<?xml version="1.0"?>
<ruleset name="prompt-library">
    <description>PSR-12 for the plugin code and its tests.</description>
    <file>src</file>
    <file>tests</file>
    <file>examples</file>
    <file>prompt-library.php</file>
    <file>uninstall.php</file>
    <file>bootstrap.php</file>
    <exclude-pattern>vendor/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12">
        <!-- Admin screens print long, escaped HTML lines; splitting them hurts reading. -->
        <exclude name="Generic.Files.LineLength"/>
    </rule>

    <!-- Entry points and the global contract declare and run at once by design. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>prompt-library.php</exclude-pattern>
        <exclude-pattern>uninstall.php</exclude-pattern>
        <exclude-pattern>bootstrap.php</exclude-pattern>
        <exclude-pattern>src/functions.php</exclude-pattern>
        <exclude-pattern>tests/stubs/*</exclude-pattern>
        <exclude-pattern>tests/phpstan-constants.php</exclude-pattern>
        <exclude-pattern>examples/*</exclude-pattern>
    </rule>

    <!-- The stub layer mirrors WordPress names and lives in the global namespace. -->
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.Classes.ValidClassName.NotCamelCaps">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Methods.CamelCapsMethodName.NotCamelCaps">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.Classes.ValidClassName">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
    </rule>
</ruleset>
